# Configuration Apache (o2switch). Ignoré par le serveur local `php -S`.

DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Transmet l'en-tête Authorization à PHP s'il est supprimé par le serveur.
    RewriteCond %{HTTP:Authorization} .+
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%0]

    # Tout ce qui n'est pas un fichier existant (routes /api/...) passe par index.php.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# En-têtes de sécurité (SEC-04). Posés ici plutôt que dans PHP pour couvrir aussi les fichiers
# statiques (index.html, JS, CSS) que PHP ne sert pas. Pas de HSTS : à ajouter seulement une fois
# le HTTPS confirmé sur le domaine.
<IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "same-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

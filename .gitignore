# Dépendances
vendor/
node_modules/

# Bases de données : données personnelles, jamais versionnées (voir CLAUDE.md)
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db

# Secrets et configuration locale : .env est versionné (valeurs par défaut sans secret),
# les valeurs réelles vont dans .env.local (voir bloc Symfony ci-dessous)
config.local.php

# Caches et résultats de tests
.phpunit.result.cache
.php-cs-fixer.cache
.phpstan.cache
*.log

# Configuration propre à l'éditeur ou à l'outil
.claude/settings.local.json
.idea/
.vscode/

# Fichiers système
.DS_Store
Thumbs.db

